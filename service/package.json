{
  "name": "easychat-service",
  "version": "1.0.0",
  "private": true,
  "description": "EasyChat Service",
  "author": "magicdmer <magicdmer@163.com>",
  "keywords": [
    "easychat",
    "chatgpt",
    "chatbot",
    "express"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start": "tsx ./src/index.ts",
    "dev": "tsx watch ./src/index.ts",
    "prod": "node --import tsx ./build/index.js",
    "build": "pnpm clean && tsup",
    "clean": "rimraf build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "audit:security": "pnpm audit --registry=https://registry.npmjs.org"
  },
  "dependencies": {
    "@easychat/plugin-sdk": "file:./plugin-sdk",
    "ajv": "^8.17.1",
    "axios": "^1.19.0",
    "dayjs": "^1.11.7",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "gpt-token": "^0.0.5",
    "hash-wasm": "^4.11.0",
    "https-proxy-agent": "^5.0.1",
    "isomorphic-fetch": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.2.0",
    "node-fetch": "^3.3.0",
    "nodemailer": "^6.9.1",
    "openai": "^4.52.0",
    "request-ip": "^3.3.0",
    "socks-proxy-agent": "^7.0.0",
    "sqlite3": "^6.0.1",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.35.3",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^8.35.0",
    "rimraf": "^6.1.3",
    "tsup": "^6.6.3",
    "typescript": "^4.9.5"
  }
}
