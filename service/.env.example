# ---- 服务 ----
PORT=3002
TIMEOUT_MS=600000
OPENAI_API_DISABLE_DEBUG=false

# ---- OpenAI 兼容接口 ----
# 可选的初始 Key 和接口地址；运行后也可以在管理员页面维护 Key 池。
OPENAI_API_KEY=
OPENAI_API_BASE_URL=
DEFAULT_CHAT_MODEL=
# 首轮对话完成后用于生成会话标题；留空时使用本地标题。
TITLE_MODEL=

# 旧 MG 图片生成服务；两项同时填写时优先使用。
MG_API_BASE_URL=
MG_API_KEY=

# ---- 登录与注册 ----
# 非空时启用登录和 JWT 鉴权。
AUTH_SECRET_KEY=
AUTH_MAX_REQUEST_PER_MINUTE=5
ROOT_USER=
PASSWORD_MD5_SALT=anysalt
REGISTER_ENABLED=true
REGISTER_REVIEW=false
REGISTER_MAILS=
SITE_DOMAIN=

# ---- 请求限制与代理 ----
# 0 或留空表示不限制。
MAX_REQUEST_PER_HOUR=0
HTTPS_PROXY=
SOCKS_PROXY_HOST=
SOCKS_PROXY_PORT=
SOCKS_PROXY_USERNAME=
SOCKS_PROXY_PASSWORD=

# ---- SMTP 邮件 ----
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# 旧版变量 SMTP_TSL 仅保留兼容读取，新配置请使用 SMTP_TLS。

# ---- 上传 ----
UPLOAD_MAX_SIZE_MB=10
# 清理间隔，单位分钟；设为 0 可关闭清理器。
UPLOAD_CLEAN_INTERVAL=60
# 文件保留时间，单位小时。
UPLOAD_SAVE_HOURS=24

# ---- 插件 ----
# 默认使用当前工作目录下的 plugins；容器内为 /app/plugins。
PLUGIN_DIR=
