    "chart.js": "^4.3.0",
    "dayjs": "^1.11.7",
    "highlight.js": "^11.7.0",
    "html2canvas": "^1.4.1",
    "jwt-decode": "^3.1.2",
    "katex": "^0.16.4",
    "localforage": "^1.10.0",
    "markdown-it": "^13.0.1",
    "naive-ui": "^2.34.3",
    "pinia": "^2.0.33",
    "vue": "^3.2.47",
    "vue-chartjs": "^5.2.0",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.1.6"
